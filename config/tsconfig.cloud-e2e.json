{
  // Why this project exists: seven renderer-side cloud e2e specs (`*.e2e.test.ts`) drive the real
  // main-process stack — a platform process, runtime admission, and the e2e harness — but they
  // live under src/renderer/src because that is where the browser code they exercise lives. They
  // are Node tests (`@vitest-environment node`), so the web project cannot typecheck them: listing
  // src/main there would drag the whole main graph into a browser project, and listing only the
  // hand-picked main subset it does own rejects every other main file with TS6307. This project
  // owns that cross-boundary set instead, keeping `tc:web` browser-only while these specs stay in
  // the `pnpm tc` chain.
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "../src/main/**/*",
    "../src/shared/**/*",
    "../src/preload/**/*",
    "../src/types/**/*",
    "../config/scripts/vitest-host-ports-setup.ts",
    // Ambient renderer declarations (vite client types, build-time defines) the specs rely on.
    "../src/renderer/src/env.d.ts",
    // The ten specs, plus the renderer modules they import; everything transitive follows.
    "../src/renderer/src/cloud-admin/cloud-admin-session.e2e.test.ts",
    "../src/renderer/src/cloud-admin/cloud-simple-workspace.e2e.test.ts",
    "../src/renderer/src/cloud-admin/cloud-simple-workspace-dual-client.e2e.test.ts",
    "../src/renderer/src/cloud/cloud-browser-host-key.e2e.test.ts",
    "../src/renderer/src/web/web-cloud-connect.e2e.test.ts",
    "../src/renderer/src/web/web-cloud-handoff.e2e.test.ts",
    "../src/renderer/src/web/web-cloud-handoff-entry.e2e.test.ts",
    "../src/renderer/src/web/web-cloud-session-recovery.e2e.test.ts",
    "../src/renderer/src/web/web-cloud-session-renewal.e2e.test.ts",
    "../src/renderer/src/web/web-cloud-session-restore.e2e.test.ts",
    "../src/renderer/src/web/web-cloud-session.e2e.test.ts",
    "../src/renderer/src/web/web-cloud-transport.e2e.test.ts",
    "../src/renderer/src/cloud/cloud-browser-bridge.ts",
    "../src/renderer/src/cloud/cloud-project-repos.ts",
    "../src/renderer/src/cloud/cloud-simple-workspace-end-close.ts",
    "../src/renderer/src/cloud/use-cloud-session.ts",
    "../src/renderer/src/web/web-cloud-connect.ts",
    "../src/renderer/src/web/web-cloud-device-key.ts",
    "../src/renderer/src/web/web-cloud-session.ts",
    "../src/renderer/src/web/web-cloud-session-restore.ts",
    "../src/renderer/src/web/web-cloud-session-storage.ts",
    "../src/renderer/src/web/web-pairing.ts",
    "../src/renderer/src/web/web-preload-api-test-harness.ts",
    "../src/renderer/src/web/web-runtime-connection-transport.ts",
    "../src/renderer/src/web/preload-api/web-runtime-session.ts"
  ],
  "compilerOptions": {
    // `electron-vite/node` carries the `*?asset` declarations main's graph imports, exactly as
    // config/tsconfig.node.json relies on.
    "types": ["node", "electron-vite/node"],
    "paths": {
      "@renderer/*": ["../src/renderer/src/*"],
      "@/*": ["../src/renderer/src/*"]
    }
  }
}
