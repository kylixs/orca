{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "../electron.vite.config.*",
    "./vitest.config.ts",
    "./build-plugins/**/*",
    "./scripts/vitest-host-ports-setup.ts",
    "./scripts/vitest-caller-identity-env-setup.ts",
    "./scripts/vitest-real-agent-home-write-guard.ts",
    "./scripts/vitest-bun-node-builtins.ts",
    "./scripts/vitest-node-runtime-pool.ts",
    "../src/main/**/*",
    "../src/renderer/src/lib/skill-freshness-display-status.ts",
    "../src/renderer/src/components/native-chat/native-chat-resolution-receipt.ts",
    "../src/renderer/src/components/native-chat/structured-agent-question-projection.ts",
    "../src/renderer/src/components/native-chat/native-chat-subagent-delegation.ts",
    "../src/renderer/src/components/native-chat/structured-agent-session-queued-cards.ts",
    "../src/renderer/src/components/native-chat/structured-agent-session-pending-sends.ts",
    "../src/renderer/src/components/native-chat/native-chat-composer-primary-action.ts",
    "../src/preload/**/*",
    "../src/shared/**/*",
    "../src/packages/process-host/src/__fixtures__/**/*",
    "../src/relay/**/*",
    "../src/types/**/*",
    // The platform's credential twin is dependency-free, so parity tests can import it.
    "../cloud-platform/packages/contract/src/credential.ts"
  ],
  "exclude": [
    // Why cloud-e2e owns them: each imports a renderer module this project does not list.
    "../src/main/cloud-platform/cloud-create-failure.test.ts",
    "../src/main/cloud-platform/cloud-project-archive.test.ts",
    "../src/main/cloud-platform/cloud-provision-recovery.test.ts",
    "../src/main/cloud-platform/cloud-repo-registration.test.ts",
    "../src/main/cloud-platform/cloud-self-service-project.test.ts",
    "../src/main/cloud-platform/cloud-runtime-environment-pairing-continuity.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["electron-vite/node"]
  }
}
